# Secrets - never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/

# Ledger data: data/ledger.json (the seeded demo ledger) IS committed as the
# baseline scorecard. Logs and old sqlite snapshots are not.
data/*.log
data/*.db
data/*.db-journal
data/*backup*.db

