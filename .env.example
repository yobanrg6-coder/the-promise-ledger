# TopicAhead Configuration

# Gemini API Key (Get your free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection - use a stable alias, not a pinned version. Pinned model
# names (e.g. gemini-2.5-flash) get retired from new accounts without notice;
# the *-latest aliases always resolve to Google's current recommended model.
# gemini-flash-lite-latest is the default here because it proved reliable
# under this project's tool-calling + large structured-output load during
# testing, while gemini-flash-latest returned 503 "high demand" repeatedly
# for the same requests. Try gemini-flash-latest if you want more capability
# and can tolerate occasional retries.
MODEL=gemini-flash-lite-latest

# Second independent verifier model (Gemma) - used to reconcile the
# Virality Auditor's draft audits, same pattern as the sibling hackathon
# projects (Trusted Hire Mexico, ScopeCouncil).
GEMMA_MODEL=gemma-4-26b-a4b-it

# FastMCP Server Connection
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# Web Dashboard Port
WEB_APP_PORT=8000
