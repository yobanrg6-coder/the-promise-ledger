# The Promise Ledger Configuration

# Gemini API Key (Get your free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection - pinned to an explicit Gemini 3.5+ version, as the
# "All Things Agentic" hackathon rules require ("Gemini 3.5 or newer"). The
# *-latest aliases were flagged by the organizer's eligibility check because
# they can still resolve to a 2.x model on some accounts. gemini-3.5-flash-lite
# proved reliable under this project's tool-calling + large structured-output
# load; gemini-3.6-flash is a drop-in upgrade if you want more capability.
MODEL=gemini-3.5-flash-lite

# Second independent verifier model (Gemma) - used to reconcile the
# Virality Auditor's draft audits, same pattern as the sibling hackathon
# projects (Trusted Hire Mexico, ScopeCouncil).
GEMMA_MODEL=gemma-4-26b-a4b-it

# FastMCP Server Connection
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# Web Dashboard Port
WEB_APP_PORT=8000
