# The Promise Ledger - configuration

# Gemini API key - only needed for the live extraction pipeline (the web app's
# /api/extract-stream). The verification cycle, the seed, and the MCP ledger
# tools never call an LLM. Free key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Extractor model - pinned to an explicit Gemini 3.5+ version, as the
# "All Things Agentic" hackathon rules require. The *-latest aliases were
# flagged by the organizer's eligibility check because they can still resolve
# to a 2.x model on some accounts. gemini-3.6-flash is a drop-in upgrade.
MODEL=gemini-3.5-flash-lite

# Adversarial auditor model - a genuinely different family (Gemma) gives an
# independent second read on "is this promise actually falsifiable".
GEMMA_MODEL=gemma-4-26b-a4b-it

# Ledger backend: json (default, data/ledger.json - the seeded demo ships
# this way) | firestore | memory
LEDGER_BACKEND=json
# LEDGER_JSON_PATH=./data/ledger.json

# FastMCP server
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8080
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# Web app port
WEB_APP_PORT=8000
